# ===================================================================
# ARQUIVO .GITIGNORE - Projeto Odontologia Frontend
# ===================================================================
# Este arquivo impede que informacoes sensiveis e arquivos desnecessarios
# sejam enviados para o repositorio remoto (GitHub)
# ===================================================================

# ===================================================================
# 1. ARQUIVOS DE AMBIENTE E CREDENCIAIS (INFORMACOES SENSIVEIS)
# ===================================================================
# Arquivos de variavel de ambiente - NUNCA commitar!
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# Arquivos de configuracao com credenciais
*.env
.env.*
!.env.example

# Chaves e certificados
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Arquivos de configuracao de banco de dados
*.sql
*.sqlite
*.db

# Configuracoes de servicos cloud
firebase*.json
serviceAccount*.json
*-service-account.json

# ===================================================================
# 2. DEPENDENCIAS E PACOTES
# ===================================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===================================================================
